// Firestore Rules — secured admin + public create-only (toggle App Check line in prod)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Helper: admin allow-list --------
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
             && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // -------- Public Contact Form --------
    match /contacts/{doc} {
      // Public can create a new contact message (no read)
      allow create: if request.auth == null
                    && request.time < timestamp.date(2099,1,1)
                    // In PROD, enforce App Check (uncomment the next line AFTER enabling App Check):
                    // && request.appcheck.token != null
                    && request.resource.data.keys().hasOnly([
                         'name','email','phone','reason','message',
                         'createdAt','status','userAgent','page'
                       ])
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;

      // Only admins can read/update (no delete by default; change to isAdmin() if you want)
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // -------- Public Booking Form --------
    match /bookings/{doc} {
      // Public can create a booking request (no read)
      allow create: if request.auth == null
                    && request.time < timestamp.date(2099,1,1)
                    // In PROD, enforce App Check (uncomment the next line AFTER enabling App Check):
                    // && request.appcheck.token != null
                    && request.resource.data.keys().hasOnly([
                         'serviceSlug','serviceTitle',
                         'patient','preference','contact',
                         'status','createdAt','userAgent'
                       ])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt == request.time;

      // Only admins can read/update (no delete by default)
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // -------- Admin allow-list document --------
    // Manage this collection only from the console (do not allow client access)
    // -------- Admin allow-list document --------
// L'utilisateur connecté peut lire SON propre doc admin (rien d’autre).
match /admins/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow write: if false; // tu gères l'ajout/modif depuis la console uniquement
}

  }
}
